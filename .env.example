# Copy to .env (never commit .env)
# (Old VALTAKIRJA_* names still work as a fallback.)
VALIO_AIMO_API_BASE=https://junction26.valioaimo.fi/api
VALIO_AIMO_API_KEY=
ANTHROPIC_API_KEY=
# LLM buyer agent (agent/, scripts/llm_eval.py): one of these, see agent/llm.py
GEMINI_API_KEY=
VERDA_INFERENCE_API_KEY=
# LLM_PROVIDER=gemini|verda|local  LLM_MODEL=  LLM_BASE_URL=  LLM_API_KEY=  LLM_REASONING_EFFORT=
# Public deployment
SOUS_PUBLIC_BASE_URL=
SOUS_APPROVER_CODE=
# Passkey approval (docs/PROTOCOL.md 26): default RP ID/origin = host of SOUS_PUBLIC_BASE_URL
# SOUS_PASSKEY_RP_ID=  SOUS_PASSKEY_ORIGINS=https://a.example,https://b.example
# 1 = every mandate needs the agent bearer credential (otherwise only mandates with require_agent_auth)
SOUS_REQUIRE_AGENT_AUTH=
# Judge sandbox (POST /sandbox); defaults shown. SOUS_SANDBOX=0 turns it off.
# SOUS_SANDBOX_QUOTES=15  SOUS_SANDBOX_PER_IP_HOUR=3  SOUS_SANDBOX_MAX_ACTIVE=50  SOUS_SANDBOX_TTL_HOURS=24
# SOUS_SANDBOX_CALLS_PER_MIN= (default: half of SOUS_AIMO_CALLS_PER_MIN)
# MariaDB (compose sets SOUS_DB_URL from this); leave SOUS_DB_URL unset for local SQLite
MARIADB_PASSWORD=
# Aiven for Valkey: one Valio Aimo budget/circuit/cache for all deployments (docs/AIVEN.md); empty = per-process
SOUS_VALKEY_URL=
# prod | staging | ci | demo | dev (only prod may use the whole shared budget)
SOUS_DEPLOYMENT_ROLE=
# SOUS_VALIO_GLOBAL_CALLS_PER_MIN=60
# Reference buyer agent demo (agent/server.py, page /ui/agent.html): mounted at /agent/ only when 1.
# Uses GEMINI_API_KEY (menu, ask), NVIDIA_API_KEY (photo), VERDA_INFERENCE_API_KEY (ask fallback).
SOUS_BUYER_AGENT=0
# SOUS_AGENT_DAILY_USD=5
# SOUS_AGENT_PER_IP_HOUR=10
# SOUS_AGENT_MAX_IMAGE_MB=4
# Stock shown to agents: buckets (default) | exact | approver_exact (docs/PROTOCOL.md 5.2)
# SOUS_STOCK_EXPOSURE=buckets
# Short stock across buyers, set by Valio: first_come (default) | pro_rata by 4-week volume (docs/PROTOCOL.md 5.3)
# SOUS_ALLOCATION=first_come
# SOUS_RESERVATION_TTL_MINUTES=30
# Mock Valio whose stock never moves: end a reservation once a fresh reading (>60 s later) is unchanged
# SOUS_RESERVATION_RELEASE_UNCHANGED=0
